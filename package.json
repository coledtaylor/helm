{
  "name": "helm-workspace",
  "version": "0.0.1",
  "description": "Portable desktop shell on top of Claude Code",
  "author": "Cole Taylor",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @helm/desktop dev",
    "dev:live": "pnpm --filter @helm/desktop dev:live",
    "build": "pnpm --filter @helm/desktop build",
    "start": "pnpm --filter @helm/desktop start",
    "typecheck": "pnpm -r --sequential typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @helm/desktop test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "shell": "pnpm --filter @helm/desktop shell",
    "selftest": "pnpm --filter @helm/desktop selftest",
    "fidelity": "pnpm --filter @helm/desktop fidelity",
    "claude-check": "pnpm --filter @helm/desktop claude-check",
    "packaging-check": "pnpm --filter @helm/desktop packaging-check",
    "verify:installer": "pnpm --filter @helm/desktop verify:installer",
    "dist:win": "pnpm --filter @helm/desktop dist:win",
    "verify:artifact": "pnpm --filter @helm/desktop verify:artifact",
    "db:generate": "pnpm --filter @helm/core db:generate",
    "icon": "pnpm --filter @helm/desktop icon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
