# A flat node_modules, the same shape npm produces.
#
# Spike B verified the packaging config (electron-builder, npmRebuild off,
# asarUnpack of node-pty's conpty/winpty helper binaries) against npm's hoisted
# layout. pnpm's default symlinked store changes how electron-builder resolves
# and copies native modules, which is exactly the thing that spike proved.
# Keeping the layout hoisted keeps that proof valid; workspace linking is
# unaffected.
node-linker=hoisted
