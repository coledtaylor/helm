{
  "name": "@helm/core",
  "version": "0.0.1",
  "description": "Headless Helm logic: discovery, store, launch. Never imports Electron.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store/index.ts",
    "./discovery": "./src/discovery/index.ts"
